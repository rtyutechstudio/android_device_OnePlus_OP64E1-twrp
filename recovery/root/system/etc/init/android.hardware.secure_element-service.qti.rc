service vendor.secure_element /odm/bin/hw/android.hardware.secure_element-service.qti
    class early_hal
    user root
    group root
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib

